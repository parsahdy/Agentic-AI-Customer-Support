# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=agent_db

# Database Names (used by local connection strings)
MAIN_DB_NAME=agent_db
MEMORY_DB_NAME=agent_memory

# Database Connection URLs
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@db:5432/agent_db
MEMORY_DATABASE_URL=host=db port=5432 dbname=agent_memory user=postgres password=yourpassword

# Memory Configuration
MEMORY_BACKEND=postgres

# LLM Provider API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TYPESAFE_API_KEY=your_typesafe_api_key_here

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=langsmith_project_name
